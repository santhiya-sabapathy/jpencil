PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=ecommerce
# Apply pending migrations automatically on application start
DB_MIGRATIONS_RUN=true
# Log SQL queries (useful when debugging transactions / locks)
DB_LOGGING=false

# Use a long random string in any real environment
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h

BCRYPT_SALT_ROUNDS=10
